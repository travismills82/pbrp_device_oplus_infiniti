cc_library_shared {
    name: "libpbrp_touch_compat",
    srcs: ["touch_compat.cpp"],
    shared_libs: [
        "libbase",
        "libutils",
    ],
    compile_multilib: "64",
    recovery_available: true,
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

prebuilt_etc {
    name: "pbrp_bundled_magisk_zip",
    src: "prebuilts/magisk/Magisk.zip",
    filename: "Magisk.zip",
    sub_dir: "magisk",
    recovery: true,
}
