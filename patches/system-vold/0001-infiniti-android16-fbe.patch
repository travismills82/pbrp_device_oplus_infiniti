     LOG(INFO) << "Installed fscrypt key with ref " << ref << " to " << mountpoint;
 
-    if (!installProvisioningKey(key, ref, arg->key_spec)) return false;
+    // Recovery keeps /data mounted for the lifetime of the process, so the
+    // filesystem key installed above is sufficient for decryption.  Some
+    // recovery ramdisks do not create Android's optional "fscrypt" session
+    // keyring; failing the whole operation here makes a successfully installed
+    // key look invalid and causes the FBE path to fall back to legacy FDE.
+    // Keep the provisioning copy when available, but match the working TWRP
+    // behavior and do not reject the filesystem key when that cache is absent.
+    if (!installProvisioningKey(key, ref, arg->key_spec)) {
+        LOG(WARNING) << "Unable to cache fscrypt key " << ref
+                     << " in the recovery session keyring; continuing with filesystem key";
+    }
     return true;
 }
 
