 #include "Keymaster.h"
 
+#include <chrono>
+#include <thread>
+
 #include <android-base/logging.h>
 
 #include <aidl/android/hardware/security/keymint/SecurityLevel.h>
@@ -104,7 +107,21 @@ bool KeymasterOperation::finish(std::string* output) {
 }
 
 Keymaster::Keymaster() {
-    ::ndk::SpAIBinder binder(AServiceManager_waitForService(keystore2_service_name));
+    // Keystore2 starts in parallel with recovery and can register several
+    // seconds after the process itself is reported running.  Poll for a
+    // bounded interval: a one-shot check races normal startup, while
+    // waitForService can freeze recovery forever when a proprietary service is
+    // broken or absent.
+    ::ndk::SpAIBinder binder;
+    constexpr auto kKeystoreStartupTimeout = std::chrono::seconds(15);
+    constexpr auto kKeystorePollInterval = std::chrono::milliseconds(100);
+    const auto deadline = std::chrono::steady_clock::now() + kKeystoreStartupTimeout;
+    do {
+        binder = ::ndk::SpAIBinder(AServiceManager_checkService(keystore2_service_name));
+        if (binder.get() != nullptr) break;
+        std::this_thread::sleep_for(kKeystorePollInterval);
+    } while (std::chrono::steady_clock::now() < deadline);
+
     auto keystore2Service = ks2::IKeystoreService::fromBinder(binder);
 
     if (!keystore2Service) {
