 	if getMakeVars(ctx, "PB_TORCH_MAX_BRIGHTNESS") != "" {
 		cflags = append(cflags, "-DPB_MAX_BRIGHT_VALUE="+getMakeVars(ctx, "PB_TORCH_MAX_BRIGHTNESS"))
