diff --git a/partitionmanager.cpp b/partitionmanager.cpp
index a311808b69dbade392e6100fddf50d8f8e66d7db..f9b5def50144095ac8a8bb8d2c7f22f82a9c3059 100755
--- a/partitionmanager.cpp
+++ b/partitionmanager.cpp
@@ -268,6 +268,7 @@ void inline Process_Keymaster_Version(TWPartition *ven, bool Display_Error) {
 }
 
 int TWPartitionManager::Process_Fstab(string Fstab_Filename, bool Display_Error, bool recovery_mode) {
+	property_set("twrp.fstab.ready", "0");
 	FILE* fstabFile;
 	char fstab_line[MAX_FSTAB_LINE_LENGTH];
 	bool parse_userdata = false;
@@ -439,6 +440,10 @@ clear:
 	if (recovery_mode)
 		Process_Keymaster_Version(ven, false);
 	if (ven) ven->UnMount(Display_Error);
+	// Device HALs consume the recovery ramdisk at /vendor and /odm. Publish
+	// readiness only after temporary stock mounts no longer hide those files.
+	if ((!ven || !ven->Is_Mounted()) && (!odm || !odm->Is_Mounted()))
+		property_set("twrp.fstab.ready", "1");
 	return true;
 }
 
@@ -2122,6 +2127,10 @@ void TWPartitionManager::Post_Decrypt(const string& Block_Device) {
 
 void TWPartitionManager::Parse_Users() {
 #ifdef TW_INCLUDE_FBE
+	// This is also called after /data is remounted following decryption.  Rebuild
+	// the list instead of retaining stale or duplicate entries from the previous
+	// pass.
+	Users_List.clear();
 	char user_check_result[PROPERTY_VALUE_MAX];
 	for (int userId = 0; userId <= 9999; userId++) {
 		string prop = "twrp.user." + to_string(userId) + ".decrypt";
@@ -2242,11 +2251,37 @@ int TWPartitionManager::Decrypt_Device(string Password, int user_id) {
 				user_need_decrypt = true;
 			}
 		}
+		// The in-memory user list can become stale after metadata encryption has
+		// mounted /data or the recovery UI has been restarted.  The property is
+		// only set to 1 after fscrypt has actually installed the user's CE key, so
+		// use it as the authoritative cross-check before skipping verification.
+		char user_decrypt_state[PROPERTY_VALUE_MAX];
+		const string user_decrypt_prop =
+				"twrp.user." + to_string(user_id) + ".decrypt";
+		property_get(user_decrypt_prop.c_str(), user_decrypt_state, "0");
+		if (strcmp(user_decrypt_state, "1") != 0) {
+			user_need_decrypt = true;
+		}
 		if (!user_need_decrypt) {
 			LOGINFO("User %d does not require decryption\n", user_id);
 			return 0;
 		}
 
+		// The Infiniti device helper publishes this state before restarting the
+		// secure-element, Weaver, KeyMint, and Keystore services.  Never submit a
+		// credential while that chain is still being assembled.
+		std::string decrypt_prereq =
+				android::base::GetProperty("twrp.decrypt.prereq", "");
+		for (int wait = 0; decrypt_prereq == "preparing" && wait < 60; ++wait) {
+			sleep(1);
+			decrypt_prereq =
+					android::base::GetProperty("twrp.decrypt.prereq", "");
+		}
+		if (!decrypt_prereq.empty() && decrypt_prereq != "ready") {
+			gui_err("decrypt_services_unavailable=Decryption services are not ready. Please retry after recovery finishes starting.");
+			return -1;
+		}
+
 		int retry_count = 10;
 		while (!TWFunc::Path_Exists("/data/system/users/gatekeeper.password.key") && --retry_count)
 			usleep(2000);	// A small sleep is needed after mounting /data to ensure reliable decrypt...
@@ -3447,6 +3482,16 @@ void TWPartitionManager::Set_Active_Slot(const string& Slot) {
 	LOGINFO("Setting active slot %s\n", Slot.c_str());
 #ifdef AB_OTA_UPDATER
 	if (!Active_Slot_Display.empty()) {
+#ifdef TW_USE_AIDL_BOOT_CONTROL
+		const string slot_number = Slot == "B" ? "1" : "0";
+		const string command = "/system/bin/pbrp-bootctl set-active-boot-slot " + slot_number;
+		if (TWFunc::Exec_Cmd(command, false, true) != 0) {
+			gui_msg(Msg(msg::kError,
+									"unable_set_boot_slot=Error changing bootloader boot slot to {1}")(Slot));
+			return;
+		}
+		DataManager::SetValue("tw_active_slot", Slot);
+#else
 		android::sp<IBootControl> module = IBootControl::getService();
 		if (module == nullptr) {
 			LOGERR("Error getting bootctrl module.\n");
@@ -3462,8 +3507,9 @@ void TWPartitionManager::Set_Active_Slot(const string& Slot) {
 										"unable_set_boot_slot=Error changing bootloader boot slot to {1}")(Slot));
 		}
 		DataManager::SetValue("tw_active_slot",
-													Slot);	// Doing this outside of this if block may result in a seg fault
+											Slot);	// Doing this outside of this if block may result in a seg fault
 																	// because the DataManager may not be ready yet
+#endif
 	}
 #else
 	LOGERR("Boot slot feature not present\n");
