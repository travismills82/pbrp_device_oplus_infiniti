@@ -201,6 +201,10 @@ func globalFlags(ctx android.BaseContext) []string {
 		cflags = append(cflags, "-DPB_TORCH_PATH="+getMakeVars(ctx, "PB_TORCH_PATH"))
 	}
 
+	if getMakeVars(ctx, "PB_TORCH_PATH_2") != "" {
+		cflags = append(cflags, "-DPB_TORCH_PATH_2="+getMakeVars(ctx, "PB_TORCH_PATH_2"))
