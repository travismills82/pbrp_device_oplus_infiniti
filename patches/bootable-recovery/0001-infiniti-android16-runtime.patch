--- a/gui/action.cpp
+++ b/gui/action.cpp
@@ -2408,9 +2408,10 @@ int GUIAction::repack(std::string arg __unused)
 int GUIAction::flashlight(std::string arg __unused)
 {
 	int br_value = DataManager::GetIntValue("pb_bright_value");
-	string str_val, file, flashp1 = "/sys/class/leds", flashp2 = "/flashlight", flashpath;
+	string file, flashp1 = "/sys/class/leds", flashp2 = "/flashlight", flashpath;
 	string bright = "/brightness";
 	string switch_path = TWFunc::Path_Exists(flashp1 + "/led:switch" + bright) ? (flashp1 + "/led:switch") : (flashp1 + "/led:switch_0");
+	std::vector<string> flashpaths;
 	DIR* d;
 	struct dirent* de __attribute__((unused));
 #ifdef PB_MAX_BRIGHT_VALUE
@@ -2425,12 +2426,32 @@ int GUIAction::flashlight(std::string arg __unused)
 		d = opendir(flashpath.c_str());
 		if (d != NULL) {
 			flashpath += bright;
+			closedir(d);
+			flashpaths.push_back(flashpath);
 			DataManager::SetValue("pb_flashlight_theme_support", "1");
 		}
 	}
+#ifdef PB_TORCH_PATH_2
+	flashpath = PB_TORCH_PATH_2;
+	LOGINFO("flashlight: Secondary custom node located at '%s'\n", flashpath.c_str());
+	if (TWFunc::Path_Exists(flashpath))
+	{
+		d = opendir(flashpath.c_str());
+		if (d != NULL) {
+			flashpath += bright;
+			closedir(d);
+			flashpaths.push_back(flashpath);
+		}
+	}
+#endif
 #else
 	flashpath = flashp1 + flashp2 + bright;
-	if (!TWFunc::Path_Exists(flashpath))
+	if (TWFunc::Path_Exists(flashpath))
+	{
+		flashpaths.push_back(flashpath);
+		DataManager::SetValue("pb_flashlight_theme_support", "1");
+	}
+	else
 	{
 		d = opendir(flashp1.c_str());
 		if (d == NULL)
@@ -2441,9 +2462,10 @@ int GUIAction::flashlight(std::string arg __unused)
 		while ((de = readdir(d)) != NULL)
 		{
 			file = de->d_name;
-			if(file.find("torch") != string::npos || file.find("torch_"))
+			if(file.find("torch") != string::npos || file.find("torch_") != string::npos)
 			{
 				flashpath = flashp1 + "/" + file + bright;
+				flashpaths.push_back(flashpath);
 				break;
 			}
 		}
@@ -2452,25 +2474,35 @@ int GUIAction::flashlight(std::string arg __unused)
 		DataManager::SetValue("pb_flashlight_theme_support", "1");
 	}
 #endif
-	str_val="";
-	if (TWFunc::Path_Exists(flashpath)) {
-		LOGINFO("Flashlight Node Located at '%s'\n", flashpath.c_str());
+	if (!flashpaths.empty()) {
+		for (const auto& path : flashpaths)
+			LOGINFO("Flashlight Node Located at '%s'\n", path.c_str());
 		if (DataManager::GetIntValue("pb_torch_on") == 1)
 		{
 			LOGINFO("Flashlight Turning Off\n");
 			if (TWFunc::Path_Exists(switch_path))
 				TWFunc::write_to_file(switch_path + bright, "0");
-			TWFunc::write_to_file(flashpath, "0");
+			for (const auto& path : flashpaths)
+				TWFunc::write_to_file(path, "0");
 			DataManager::SetValue("pb_torch_on", "0");
 		}
 		else
 		{
+			bool success = true;
 			LOGINFO("Flashlight Turning On\n");
 			LOGINFO("Flashlight: Brightning value '%d'\n", br_value);
-			TWFunc::write_to_file(flashpath, std::to_string(br_value));
+			for (const auto& path : flashpaths)
+				success = TWFunc::write_to_file(path, std::to_string(br_value)) && success;
 			if (TWFunc::Path_Exists(switch_path))
-				TWFunc::write_to_file(switch_path + bright, "1");
-			DataManager::SetValue("pb_torch_on", "1");
+				success = TWFunc::write_to_file(switch_path + bright, "1") && success;
+			if (success) {
+				DataManager::SetValue("pb_torch_on", "1");
+			} else {
+				LOGINFO("Flashlight: Failed to enable every configured node\n");
+				for (const auto& path : flashpaths)
+					TWFunc::write_to_file(path, "0");
+				DataManager::SetValue("pb_torch_on", "0");
+			}
 		}
 	} else {
 		LOGINFO("Incorrect Flashlight Path\n");
diff --git a/gui/libguitwrp_defaults.go b/gui/libguitwrp_defaults.go
index 1e09bd3e6d7fee2d14c53714a182c67a9a3d2c2e..2b09368e4ff316c1a40d3ed5f6d46c04cb31ed88 100644
