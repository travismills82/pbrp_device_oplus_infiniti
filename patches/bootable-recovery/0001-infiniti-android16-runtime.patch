diff --git a/libtar/Android.mk b/libtar/Android.mk
index c3bb691f3508a3e9a487334b9d86f5ea5458c3f3..c445f3dc93ec513393523327dc993c3d0f8ec562 100755
--- a/libtar/Android.mk
+++ b/libtar/Android.mk
@@ -22,8 +22,10 @@ ifeq ($(TW_INCLUDE_CRYPTO_FBE), true)
         android.hardware.keymaster@3.0 \
         android.hardware.keymaster@4.0 \
         android.hardware.keymaster@4.1 \
+        android.hardware.weaver-V1-ndk_platform \
         android.hardware.weaver@1.0 \
         android.security.apc-ndk_platform \
+        android.hardware.gatekeeper.pbrp-ndk_platform \
